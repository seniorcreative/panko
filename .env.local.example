# Public tracking IDs. These are exposed to the browser (NEXT_PUBLIC_*),
# so they are not secrets, but they are kept in env vars for easy
# per-environment configuration. Set the real values in Netlify's
# deploy environment variables. Copy this file to .env.local for local dev.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX (leave blank if unused)
NEXT_PUBLIC_GTM_ID=

# Google Ads account/tag ID, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads conversion label (the part after the "/" in the conversion
# send_to value), e.g. AbCdEfGhIjKlMnOp
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
